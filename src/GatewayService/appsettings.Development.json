{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "rents" : {
        "ClusterId": "rents",
        "Match": {
          "Path": "/rents/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "api/rents/{**catch-all}"
          }
        ]
      },
      "search": {
        "ClusterId": "search",
        "Match": {
          "Path": "/search/{**catch-all}",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          {
            "PathPattern": "api/search/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "rents": {
        "Destinations": {
          "rentApi": {
            "Address": "https://localhost:7001"
          }
        }
      },
      "search": {
        "Destinations": {
          "searchApi": {
            "Address": "https://localhost:7002"
          }
        }
      }
    }
  }
}
